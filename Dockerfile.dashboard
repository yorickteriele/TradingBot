# Build stage
FROM alpine/git:2.36.3 as git
ARG GIT_REPO
ARG GIT_BRANCH=main
WORKDIR /app
RUN git clone --depth 1 --branch ${GIT_BRANCH} ${GIT_REPO} .

# Build stage for Python dependencies
FROM python:3.10-slim as builder
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker cache
COPY --from=git /app/requirements.txt .
RUN pip install --user -r requirements.txt

# Final stage
FROM python:3.10-slim
WORKDIR /app

# Copy installed Python packages and application code
COPY --from=builder /root/.local /root/.local
COPY --from=git /app/ .

# Ensure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

# Create a non-root user and switch to it
RUN useradd -m dashboard && chown -R dashboard:dashboard /app
USER dashboard

# Expose the port the app runs on
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import psycopg2; psycopg2.connect(host='db', dbname='${DB_NAME:-tradingbot}', user='${DB_USER:-postgres}', password='${DB_PASSWORD}');" || exit 1

# Command to run the application
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
